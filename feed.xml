---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self"/>
  <link href="{{ '/' | absolute_url }}"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/' | absolute_url }}</id>
  {% assign everything = site.notes | concat: site.stories | sort: 'date' | reverse %}
  {% for doc in everything limit: 20 %}
  <entry>
    <title>{{ doc.title | xml_escape }}</title>
    <link href="{{ doc.url | absolute_url }}"/>
    <id>{{ doc.url | absolute_url }}</id>
    <updated>{{ doc.date | date_to_xmlschema }}</updated>
    <content type="html">{{ doc.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
